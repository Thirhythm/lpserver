# HTTP server (bind to 127.0.0.1 when behind Nginx)
PORT=3000
HOST=127.0.0.1

# API key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-64-hex-chars

# OpenList instance
OPENLIST_BASE_URL=http://127.0.0.1:5244
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=
# Optional: OpenList global API token. If set, username/password login is skipped.
# OPENLIST_TOKEN=

# OpenList path of the local storage mount and its disk path
OPENLIST_BASE_PATH=/
OPENLIST_LOCAL_ROOT=/home/user000/openlist

# Optional: public URL used to build download links. If empty, the site_url
# value from OpenList /api/public/settings is used, then OPENLIST_BASE_URL.
# OPENLIST_PUBLIC_URL=https://openlist.example.com

OPENLIST_TIMEOUT_MS=15000

# SHA256 cache and concurrency
HASH_CACHE_PATH=./data/hash-cache.json
SHA256_CONCURRENCY=2
